{
  "name": "@glance/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "dev:fake": "tsx watch src/main.ts --fake",
    "start": "node --import tsx src/main.ts",
    "test": "vitest run",
    "model:check": "tsx --env-file-if-exists=.env scripts/check-model.ts",
    "ask:check": "tsx --env-file-if-exists=.env scripts/check-ask.ts",
    "catalog:check": "tsx scripts/catalog-check.ts",
    "catalog:seed": "tsx --env-file-if-exists=.env scripts/catalog-seed.ts",
    "replay": "tsx --env-file-if-exists=.env scripts/replay.ts",
    "smoke": "tsx scripts/smoke.ts",
    "reference": "tsx --env-file-if-exists=.env scripts/reference.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@glance/shared": "*",
    "@google/genai": "^3.3.0",
    "fastify": "^5.12.8",
    "mongodb": "^7.9.0",
    "tsx": "^4.23.15",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/ws": "^8.18.2",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
