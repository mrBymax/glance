# Settings of the server. Copy this file to .env and fill it. Git ignores .env.
# An empty value counts as not set.

# Default: 8080
PORT=
# The address that clients use. Default: http://localhost:<PORT>
PUBLIC_BASE_URL=

# With no address, the server keeps its data in memory.
MONGODB_URI=
# Default: glance
MONGODB_DB=

# Default: catalog/catalog.dev.json
CATALOG_PATH=

# The items that the store sells, with the barcode and the price of each. Default: catalog/store-list.dev.json
STORE_LIST_PATH=
# 1 means on. The server then reads the details of a scanned product from fixtures/product-info, with no call to Open Food Facts.
FAKE_PRODUCT_INFO=
# Default: https://world.openfoodfacts.org
OFF_BASE_URL=
# Open Food Facts asks for the name of the app, its version, and a contact. Default: MetaGlance/0.1 (https://github.com/mrBymax/glance)
PRODUCT_INFO_USER_AGENT=
# The folder for the answers of Open Food Facts. Default: .cache/products
PRODUCT_CACHE_DIR=

# Needed when FAKE_RECOGNITION is off.
GEMINI_API_KEY=
# Default: gemini-3.5-flash-lite
GEMINI_MODEL=
# "default" or "low". Default: default
GEMINI_MEDIA_RESOLUTION=
# "frame" or "observe". frame: one call for each frame, with the store list and the reference pictures.
# observe: describe the held product, look it up in the store list, verify. Default: frame
RECOGNITION_PIPELINE=
# A number from 0 to 1. The verify call of the observe pipeline names an item from this confidence on. Default: 0.9
VERIFY_MIN_CONFIDENCE=
# The number of recognition calls that one session runs at the same time, from 1 to 12. Default: 8
RECOGNITION_CONCURRENCY=
# The number of reference pictures of one store item in each recognition call for a frame, from 0 to 3. 0 means none. Default: 3
RECOGNITION_REFERENCES=
# A number from 0 to 1. Default: 0.6
RECOGNITION_MIN_CONFIDENCE=
# A number from 0 to 1. The label reader chooses one item of the store list, and the server takes it from this confidence on. Default: 0.7
LABEL_MIN_CONFIDENCE=

# 1 means on. The server then drops each frame that the phone sent with blurred: false.
# Set it when the phone runs face detection (Plan 2 Task 18), and keep it set for the demo.
REQUIRE_BLUR=

# Off when empty. 1 selects fixtures/fake-script.json. Each other value is the path of a script file.
FAKE_RECOGNITION=
# 1 means on. Each speak message then has no clip.
FAKE_SPEECH=

# Needed when FAKE_SPEECH is off.
ELEVENLABS_API_KEY=
# Needed when FAKE_SPEECH is off.
ELEVENLABS_VOICE_EN=
ELEVENLABS_VOICE_IT=
# Default: .cache/speech
SPEECH_CACHE_DIR=
# 0 means off. The start then makes no clip for the product prompts of the store items.
# On, each prompt text with no clip is one ElevenLabs call at the start: 3 texts for each store item.
SPEECH_WARM_UP=

# A directory for frames. When it is set, the server writes each frame to <directory>/<sessionId>/<seq>.jpg.
# Use it only to collect frames for the test set. Keep it empty for the demo and on the deployed server.
SAVE_FRAMES=

# The length of the mock payment in milliseconds. Default: 1500
PAYMENT_DELAY_MS=

# How long the look-alike line waits for the result of a still, in milliseconds. Default: 0, which means off.
# Set it to 2500 only when the phone sends a still for each glance.ambiguous event.
SECOND_LOOK_WAIT_MS=

# A total above this number of cents needs a fingerprint check on the phone before the payment. 5000 means 50 EUR.
# Default: empty, and then no payment needs a fingerprint.
BIOMETRIC_ABOVE_CENTS=

# The key of the paths under /api/demo. GET /api/demo/latest gives the ID and the token of the newest live session to the mirror page.
# With no key, the paths answer 404. Use a long random value, because the key opens each session.
DEMO_KEY=

# The paths under /api/store add, change, and remove store items and their pictures. They take no key.
# Default: on. Set 0 on a server with a public address: the paths then answer 404.
STORE_EDIT=

# The folder with the reference pictures of the store items: <folder>/<13 digits>/<name>.jpg. Default: catalog/reference
# A picture can show a room and people. Git ignores the default folder.
REFERENCE_DIR=
