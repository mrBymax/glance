# Settings of the deployed server and the proxy. Copy this file to infra/.env and fill it. Git ignores infra/.env.
# apps/server/.env.example describes each variable of the server.

# The host name with no scheme. The proxy also serves hud.<DOMAIN>. Both names need a DNS A record.
DOMAIN=glance.example.com
# The address that the phone uses: https:// plus DOMAIN.
PUBLIC_BASE_URL=https://glance.example.com
CATALOG_PATH=catalog/catalog.dev.json
# The items that the store sells, with the barcode and the price of each.
STORE_LIST_PATH=catalog/store-list.dev.json
MONGODB_URI=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_EN=
ELEVENLABS_VOICE_IT=
# 1 means on. With both set to 1 the server needs no key.
FAKE_RECOGNITION=
FAKE_SPEECH=
# 1 means on. The server then makes no call to Open Food Facts for a scanned product.
FAKE_PRODUCT_INFO=
# A contact for Open Food Facts: the name of the app, its version, and an address.
PRODUCT_INFO_USER_AGENT=
# The user of the image can write only to the volume of the speech clips, so the answers of Open Food Facts go there.
PRODUCT_CACHE_DIR=/data/speech/products
# Set it to 1 when the phone runs face detection.
REQUIRE_BLUR=
# Set it to 2500 when the phone sends a still for look-alike products. Empty means off.
SECOND_LOOK_WAIT_MS=
# A random word of 12 characters or more. The mirror page takes it as ?latest=<key>.
DEMO_KEY=
